---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'tyre-pressure-converter')!;

const faqs = [
  {
    q: 'What is PSI?',
    a: 'PSI stands for "pounds per square inch". It is the most common tyre pressure unit in the USA and UK. Most passenger car tyres are inflated to 30–35 PSI.',
  },
  {
    q: 'What is bar?',
    a: 'Bar is a metric unit of pressure equal to approximately one atmosphere. European tyre pressure gauges often display in bar. 1 bar ≈ 14.5 PSI.',
  },
  {
    q: 'What is kPa?',
    a: 'kPa (kilopascal) is the SI unit for pressure. It is used in Canada, Australia, and parts of Asia. 100 kPa = 1 bar. Typical tyre pressure is 200–250 kPa.',
  },
  {
    q: 'What is the correct tyre pressure for my car?',
    a: 'The recommended tyre pressure is on a sticker inside your driver\'s door jamb, in your owner\'s manual, or sometimes on the fuel cap. Never use the maximum pressure printed on the tyre sidewall — that is the maximum the tyre can hold, not the recommended inflation.',
  },
  {
    q: 'Should I check pressure when tyres are hot or cold?',
    a: 'Always check tyre pressure when cold — before you have driven more than a mile or two. Driving heats up the air inside the tyre, increasing pressure by 4–6 PSI. Checking hot tyres will give a falsely high reading.',
  },
];
---

<ToolLayout tool={tool} faqs={faqs}>
  <div class="calc-cards" role="region" aria-label="Tyre pressure converter">

    <div class="calc-card">
      <p class="calc-card-title">Enter any pressure value — others update instantly</p>

      <div class="tp-grid">
        <div class="tp-field">
          <label for="tp-psi" class="tp-label">PSI</label>
          <p class="tp-sublabel">pounds per square inch</p>
          <div class="tp-input-wrap">
            <input
              id="tp-psi"
              type="number"
              class="input tp-input"
              min="0"
              step="0.1"
              placeholder="32"
              aria-label="Pressure in PSI"
            />
            <span class="tp-unit-badge">PSI</span>
          </div>
        </div>

        <div class="tp-arrow" aria-hidden="true">⇄</div>

        <div class="tp-field">
          <label for="tp-bar" class="tp-label">bar</label>
          <p class="tp-sublabel">metric (Europe)</p>
          <div class="tp-input-wrap">
            <input
              id="tp-bar"
              type="number"
              class="input tp-input"
              min="0"
              step="0.01"
              placeholder="2.21"
              aria-label="Pressure in bar"
            />
            <span class="tp-unit-badge">bar</span>
          </div>
        </div>

        <div class="tp-arrow" aria-hidden="true">⇄</div>

        <div class="tp-field">
          <label for="tp-kpa" class="tp-label">kPa</label>
          <p class="tp-sublabel">kilopascal (SI)</p>
          <div class="tp-input-wrap">
            <input
              id="tp-kpa"
              type="number"
              class="input tp-input"
              min="0"
              step="1"
              placeholder="221"
              aria-label="Pressure in kilopascals"
            />
            <span class="tp-unit-badge">kPa</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick reference -->
    <div class="calc-card">
      <p class="calc-card-title">Common tyre pressure reference</p>
      <table class="tp-table" role="table" aria-label="Common tyre pressure values">
        <thead>
          <tr>
            <th>Vehicle type</th>
            <th>PSI</th>
            <th>bar</th>
            <th>kPa</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Small / compact car</td><td>30–33</td><td>2.07–2.28</td><td>207–228</td></tr>
          <tr><td>Mid-size sedan</td><td>32–35</td><td>2.21–2.41</td><td>221–241</td></tr>
          <tr><td>SUV / 4×4</td><td>35–40</td><td>2.41–2.76</td><td>241–276</td></tr>
          <tr><td>Van / MPV</td><td>40–50</td><td>2.76–3.45</td><td>276–345</td></tr>
          <tr><td>Bicycle (road)</td><td>90–120</td><td>6.2–8.3</td><td>620–827</td></tr>
        </tbody>
      </table>
      <p style="font-size:var(--text-xs);color:var(--color-text-muted);margin-top:0.75rem">Always check your vehicle's door jamb sticker or owner's manual for the exact recommended pressure.</p>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="tp-guide">
    <h2 id="tp-guide">Why Correct Tyre Pressure Matters</h2>
    <p>Maintaining correct tyre pressure improves safety, extends tyre life, and saves fuel. Under-inflated tyres increase rolling resistance, generate more heat, and can cause blowouts. Over-inflated tyres reduce grip, increase ride harshness, and cause uneven tread wear in the centre.</p>
    <h3>Conversion Reference</h3>
    <ul>
      <li>1 PSI = 0.0689476 bar = 6.89476 kPa</li>
      <li>1 bar = 14.5038 PSI = 100 kPa</li>
      <li>1 kPa = 0.145038 PSI = 0.01 bar</li>
    </ul>
  </section>
</ToolLayout>

<style>
  .tp-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 600px) {
    .tp-grid {
      flex-direction: row;
      align-items: flex-end;
    }
    .tp-field { flex: 1; }
  }

  .tp-arrow {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: 0.625rem;
    display: none;
  }

  @media (min-width: 600px) {
    .tp-arrow { display: block; }
  }

  .tp-label {
    display: block;
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.125rem;
    letter-spacing: -0.01em;
  }

  .tp-sublabel {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .tp-input-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .tp-input-wrap:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .tp-input {
    border: none !important;
    background: transparent !important;
    flex: 1;
    min-width: 0;
    border-radius: 0 !important;
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .tp-input:focus { outline: none !important; box-shadow: none !important; }

  .tp-unit-badge {
    padding: 0 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-primary-light);
    border-left: 1px solid var(--color-border);
    white-space: nowrap;
    height: 100%;
    display: flex;
    align-items: center;
    letter-spacing: 0.04em;
  }

  .tp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .tp-table th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tp-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .tp-table tr:last-child td { border-bottom: none; }
  .tp-table td:first-child { color: var(--color-text-muted); }
</style>

<script>
  const PSI_TO_BAR = 0.0689476;
  const PSI_TO_KPA = 6.89476;

  const psiEl = document.getElementById('tp-psi') as HTMLInputElement;
  const barEl = document.getElementById('tp-bar') as HTMLInputElement;
  const kpaEl = document.getElementById('tp-kpa') as HTMLInputElement;

  let busy = false;

  function fmt(n: number, d: number): string {
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  function fromPsi(psi: number) {
    if (busy) return; busy = true;
    barEl.value = fmt(psi * PSI_TO_BAR, 3);
    kpaEl.value = fmt(psi * PSI_TO_KPA, 2);
    busy = false;
  }

  function fromBar(bar: number) {
    if (busy) return; busy = true;
    const psi = bar / PSI_TO_BAR;
    psiEl.value = fmt(psi, 2);
    kpaEl.value = fmt(bar * 100, 2);
    busy = false;
  }

  function fromKpa(kpa: number) {
    if (busy) return; busy = true;
    const psi = kpa / PSI_TO_KPA;
    psiEl.value = fmt(psi, 2);
    barEl.value = fmt(kpa / 100, 3);
    busy = false;
  }

  psiEl.addEventListener('input', () => { const v = parseFloat(psiEl.value); if (!isNaN(v) && v >= 0) fromPsi(v); });
  barEl.addEventListener('input', () => { const v = parseFloat(barEl.value); if (!isNaN(v) && v >= 0) fromBar(v); });
  kpaEl.addEventListener('input', () => { const v = parseFloat(kpaEl.value); if (!isNaN(v) && v >= 0) fromKpa(v); });
</script>
