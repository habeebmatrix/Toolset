---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'car-depreciation-calculator')!;

const faqs = [
  {
    q: 'How does car depreciation work?',
    a: 'A new car typically loses 15–25% of its value in the first year and a further 10–20% per year thereafter. This calculator uses the declining balance method: each year\'s depreciation is calculated as a percentage of the current value, not the original price.',
  },
  {
    q: 'What is the average car depreciation rate?',
    a: 'The average new car loses about 60% of its value over 5 years. The rate varies widely: luxury cars and sports cars often depreciate faster, while some brands (Toyota, Honda, Subaru) hold value better. Diesel cars have seen accelerated depreciation in recent years due to emission regulations.',
  },
  {
    q: 'What is residual value?',
    a: 'Residual value (or resale value) is the estimated worth of a vehicle at a future date. Lenders use this to calculate lease payments. A higher residual value means lower monthly lease payments.',
  },
  {
    q: 'Should I use a flat rate or the first-year hit?',
    a: 'New cars depreciate significantly more in year one (often 20–30%) compared to subsequent years. For a more accurate estimate on a new car, adjust the first-year rate. This calculator uses a consistent annual rate for simplicity.',
  },
];
---

<ToolLayout tool={tool} faqs={faqs}>
  <div class="calc-cards" role="region" aria-label="Car depreciation calculator">

    <!-- Inputs -->
    <div class="calc-card">
      <p class="calc-card-title">Vehicle details</p>
      <div class="dep-grid">
        <div class="dep-field">
          <label for="dep-price" class="dep-label">Purchase price</label>
          <div class="dep-input-wrap">
            <span class="dep-prefix">$</span>
            <input id="dep-price" type="number" class="input dep-has-prefix" min="0" step="100" placeholder="25000" aria-label="Vehicle purchase price" />
          </div>
        </div>
        <div class="dep-field">
          <label for="dep-age" class="dep-label">Current age (years)</label>
          <input id="dep-age" type="number" class="input" min="0" max="30" step="1" placeholder="3" aria-label="Vehicle age in years" />
        </div>
        <div class="dep-field">
          <label for="dep-rate" class="dep-label">Annual depreciation rate</label>
          <div class="dep-input-wrap">
            <input id="dep-rate" type="number" class="input dep-has-suffix" min="1" max="50" step="0.5" value="15" aria-label="Annual depreciation rate as percentage" />
            <span class="dep-suffix">%</span>
          </div>
          <p class="dep-hint">Typical: 15–20% per year</p>
        </div>
        <div class="dep-field">
          <label for="dep-years" class="dep-label">Project ahead (years)</label>
          <input id="dep-years" type="number" class="input" min="1" max="20" step="1" value="5" aria-label="Number of years to project ahead" />
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="calc-card" aria-live="polite" aria-atomic="true" id="dep-result-card">
      <p class="calc-card-title">Depreciation summary</p>
      <div id="dep-placeholder" style="color:var(--color-text-muted);font-size:var(--text-sm)">Enter vehicle details above.</div>
      <div id="dep-result" class="hidden">
        <div class="dep-stats-grid">
          <div class="dep-stat dep-stat--primary">
            <p class="dep-stat-value" id="dep-current-value">—</p>
            <p class="dep-stat-label">Current value</p>
          </div>
          <div class="dep-stat">
            <p class="dep-stat-value" id="dep-total-loss">—</p>
            <p class="dep-stat-label">Value lost so far</p>
          </div>
          <div class="dep-stat">
            <p class="dep-stat-value" id="dep-pct-lost">—</p>
            <p class="dep-stat-label">% of original lost</p>
          </div>
          <div class="dep-stat">
            <p class="dep-stat-value" id="dep-future-value">—</p>
            <p class="dep-stat-label" id="dep-future-label">Value in X years</p>
          </div>
        </div>

        <!-- Year-by-year table -->
        <div style="overflow-x:auto;margin-top:1.25rem">
          <table class="dep-table" id="dep-table" role="table" aria-label="Year-by-year depreciation">
            <thead>
              <tr>
                <th>Year</th>
                <th>Start value</th>
                <th>Depreciation</th>
                <th>End value</th>
                <th>Total lost</th>
              </tr>
            </thead>
            <tbody id="dep-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="dep-guide">
    <h2 id="dep-guide">Understanding Car Depreciation</h2>
    <p>Depreciation is the single biggest cost of car ownership — often exceeding fuel, insurance, and servicing combined. A typical new car loses around 60% of its value in five years.</p>
    <h3>Factors That Affect Depreciation</h3>
    <ul>
      <li><strong>Brand reliability reputation:</strong> Toyota, Honda, and Lexus hold value better than average.</li>
      <li><strong>Mileage:</strong> High annual mileage (15,000+ miles) accelerates value loss.</li>
      <li><strong>Fuel type:</strong> Diesel cars have depreciated faster in the UK since clean air zone regulations.</li>
      <li><strong>Colour:</strong> Unusual colours depreciate faster; silver, grey, and white retain value best.</li>
      <li><strong>Service history:</strong> A full documented service history is worth significantly more at resale.</li>
    </ul>
  </section>
</ToolLayout>

<style>
  .dep-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .dep-grid { grid-template-columns: 1fr; }
  }

  .dep-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }

  .dep-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .dep-input-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .dep-input-wrap:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .dep-input-wrap .input { border: none !important; background: transparent !important; flex: 1; min-width: 0; border-radius: 0 !important; }
  .dep-input-wrap .input:focus { outline: none !important; box-shadow: none !important; }

  .dep-has-prefix { padding-left: 0; }
  .dep-has-suffix { padding-right: 0; }

  .dep-prefix, .dep-suffix {
    padding: 0 0.625rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg-card);
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  .dep-prefix { border-right: 1px solid var(--color-border); }
  .dep-suffix { border-left:  1px solid var(--color-border); }

  .dep-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .dep-stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .dep-stat {
    background: var(--color-bg-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1rem 0.75rem;
    text-align: center;
  }

  .dep-stat--primary {
    border-color: var(--color-primary-muted);
    background: var(--color-primary-light);
  }

  .dep-stat-value {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .dep-stat--primary .dep-stat-value { color: var(--color-primary); }

  .dep-stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.375rem;
  }

  .dep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 420px;
  }

  .dep-table th {
    text-align: right;
    padding: 0.5rem 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dep-table th:first-child { text-align: left; }

  .dep-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-align: right;
  }

  .dep-table td:first-child { text-align: left; font-weight: 600; }
  .dep-table tr:last-child td { border-bottom: none; }
  .dep-table .dep-row-current { background: var(--color-primary-light); }
</style>

<script>
  const priceEl = document.getElementById('dep-price') as HTMLInputElement;
  const ageEl   = document.getElementById('dep-age')   as HTMLInputElement;
  const rateEl  = document.getElementById('dep-rate')  as HTMLInputElement;
  const yearsEl = document.getElementById('dep-years') as HTMLInputElement;

  function fmtMoney(n: number): string {
    return '$' + Math.round(n).toLocaleString();
  }

  function calculate() {
    const price = parseFloat(priceEl.value);
    const age   = parseFloat(ageEl.value);
    const rate  = parseFloat(rateEl.value) / 100;
    const ahead = parseInt(yearsEl.value, 10);

    const placeholder = document.getElementById('dep-placeholder')!;
    const result      = document.getElementById('dep-result')!;

    if (!price || price <= 0 || isNaN(age) || age < 0 || !rate || rate <= 0 || !ahead) {
      placeholder.classList.remove('hidden'); result.classList.add('hidden'); return;
    }

    placeholder.classList.add('hidden'); result.classList.remove('hidden');

    const currentValue = price * Math.pow(1 - rate, age);
    const totalLost    = price - currentValue;
    const pctLost      = (totalLost / price) * 100;
    const futureValue  = currentValue * Math.pow(1 - rate, ahead);

    (document.getElementById('dep-current-value') as HTMLElement).textContent = fmtMoney(currentValue);
    (document.getElementById('dep-total-loss')    as HTMLElement).textContent = fmtMoney(totalLost);
    (document.getElementById('dep-pct-lost')      as HTMLElement).textContent = pctLost.toFixed(1) + '%';
    (document.getElementById('dep-future-value')  as HTMLElement).textContent = fmtMoney(futureValue);
    (document.getElementById('dep-future-label')  as HTMLElement).textContent = `Value in ${ahead} yr${ahead !== 1 ? 's' : ''}`;

    // Build table: year 0 = now, then ahead years
    const tbody = document.getElementById('dep-tbody')!;
    const rows: string[] = [];
    let val = currentValue;
    const totalRows = ahead + 1;

    for (let i = 0; i <= ahead; i++) {
      const yearLabel = i === 0 ? 'Now' : `+${i} yr${i !== 1 ? 's' : ''}`;
      const startVal  = val;
      const dep       = i === 0 ? 0 : startVal * rate;
      const endVal    = i === 0 ? val : val - dep;
      const lostTotal = price - endVal;
      const isCurrent = i === 0;
      rows.push(`
        <tr${isCurrent ? ' class="dep-row-current"' : ''}>
          <td>${yearLabel}</td>
          <td>${fmtMoney(startVal)}</td>
          <td>${i === 0 ? '—' : fmtMoney(dep)}</td>
          <td>${fmtMoney(endVal)}</td>
          <td>${fmtMoney(lostTotal)}</td>
        </tr>
      `);
      if (i > 0) val = endVal;
    }

    tbody.innerHTML = rows.join('');
  }

  [priceEl, ageEl, rateEl, yearsEl].forEach((el) => el.addEventListener('input', calculate));
  calculate();
</script>
