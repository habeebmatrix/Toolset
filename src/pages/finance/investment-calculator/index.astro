---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'investment-calculator')!;

const faqs = [
  {
    q: 'What is a SIP calculator?',
    a: 'A SIP (Systematic Investment Plan) calculator estimates the future value of investing a fixed amount every month. It applies monthly compounding to each instalment, so earlier contributions grow for longer than later ones. Enter your monthly amount, expected annual return, and duration to see the projected corpus.',
  },
  {
    q: 'What is the difference between SIP and lumpsum investing?',
    a: 'A lumpsum is a single one-time investment that compounds for the full duration. A SIP spreads the same money across many months, so each instalment compounds for a shorter period — but it averages your purchase price over time (rupee-cost or dollar-cost averaging), which reduces the risk of investing everything at a market peak.',
  },
  {
    q: 'How is SIP return calculated?',
    a: 'The standard formula is FV = P × [((1 + i)^n − 1) / i] × (1 + i), where P is the monthly instalment, i is the monthly rate (annual rate ÷ 12 ÷ 100), and n is the number of months. This calculator runs a month-by-month simulation instead, which produces the same result and also supports annual step-up contributions.',
  },
  {
    q: 'What is a step-up SIP?',
    a: 'A step-up (or top-up) SIP increases your monthly contribution by a fixed percentage each year, usually in line with salary growth. Even a 10% annual step-up can dramatically increase your final corpus, because the extra contributions still get years of compounding.',
  },
  {
    q: 'What return rate should I assume?',
    a: 'Returns are never guaranteed. Historically, broad equity index funds have averaged roughly 10–12% per year over long periods, balanced funds 8–10%, and debt or fixed-income instruments 5–7%. Use a conservative figure and run several scenarios rather than relying on a single optimistic number.',
  },
  {
    q: 'Does this calculator account for inflation or tax?',
    a: 'No. The projection shows nominal returns before inflation, capital gains tax, and fund expense ratios. To estimate real purchasing power, subtract your expected inflation rate from the return rate — for example, enter 7% instead of 11% if you expect 4% inflation.',
  },
  {
    q: 'Is my data saved anywhere?',
    a: 'No. Every calculation runs entirely in your browser using JavaScript. Nothing is uploaded, stored, or shared, and the tool works offline once the page has loaded.',
  },
];
---

<ToolLayout
  tool={tool}
  faqs={faqs}
  seoTitle="Investment Calculator — SIP, Lumpsum & Step-Up Returns"
  seoDescription="Free investment calculator for SIP, lumpsum, and step-up plans. See total invested, estimated returns, and a year-by-year growth breakdown. No signup."
  alsoKnownAs={['SIP calculator', 'Lumpsum calculator', 'Mutual fund return calculator', 'Step-up SIP calculator']}
>
  <div class="calc-cards" role="region" aria-label="Investment calculator">

    <div class="calc-card">
      <p class="calc-card-title">Choose your investment type</p>

      <div class="inv-mode" role="group" aria-label="Investment type">
        <button class="inv-mode-btn active" id="mode-sip" aria-pressed="true">SIP (monthly)</button>
        <button class="inv-mode-btn" id="mode-lump" aria-pressed="false">Lumpsum</button>
        <button class="inv-mode-btn" id="mode-both" aria-pressed="false">Both combined</button>
      </div>

      <div class="inv-fields">
        <div class="inv-field" id="field-sip">
          <label class="inv-label" for="inv-monthly">Monthly investment</label>
          <input class="input" type="number" id="inv-monthly" value="10000" min="0" step="any" aria-label="Monthly investment amount" />
        </div>

        <div class="inv-field hidden" id="field-lump">
          <label class="inv-label" for="inv-lumpsum">Lumpsum amount</label>
          <input class="input" type="number" id="inv-lumpsum" value="100000" min="0" step="any" aria-label="One-time lumpsum amount" />
        </div>

        <div class="inv-field">
          <label class="inv-label" for="inv-rate">Expected return (% per year)</label>
          <input class="input" type="number" id="inv-rate" value="12" min="0" max="100" step="any" aria-label="Expected annual return percentage" />
        </div>

        <div class="inv-field">
          <label class="inv-label" for="inv-years">Investment period (years)</label>
          <input class="input" type="number" id="inv-years" value="10" min="1" max="50" step="1" aria-label="Investment period in years" />
        </div>

        <div class="inv-field" id="field-stepup">
          <label class="inv-label" for="inv-stepup">Annual step-up (%) <span class="inv-optional">optional</span></label>
          <input class="input" type="number" id="inv-stepup" value="0" min="0" max="50" step="any" aria-label="Annual step-up percentage" />
        </div>
      </div>

      <div class="calc-card-actions">
        <button class="btn btn-primary" id="inv-calc">Calculate</button>
        <button class="btn btn-secondary" id="inv-reset">Reset</button>
      </div>
    </div>

    <!-- Results -->
    <div id="inv-results" aria-live="polite" aria-atomic="true">
      <div class="stats-grid" style="margin-bottom:0.875rem">
        <div class="stat-card">
          <p class="stat-label">Total Invested</p>
          <p class="stat-value" id="val-invested">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Estimated Returns</p>
          <p class="stat-value" id="val-returns">—</p>
        </div>
        <div class="stat-card stat-card--primary">
          <p class="stat-label">Total Value</p>
          <p class="stat-value" id="val-total">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Wealth Multiplier</p>
          <p class="stat-value" id="val-multiple">—</p>
        </div>
      </div>

      <!-- Invested vs returns bar -->
      <div class="calc-card" style="margin-top:0">
        <p class="calc-card-title">Invested vs returns</p>
        <div class="inv-bar" role="img" aria-labelledby="inv-bar-desc">
          <div class="inv-bar-invested" id="bar-invested"></div>
          <div class="inv-bar-returns" id="bar-returns"></div>
        </div>
        <p class="inv-bar-legend" id="inv-bar-desc">
          <span><i class="inv-dot inv-dot--invested"></i> Invested <b id="pct-invested">—</b></span>
          <span><i class="inv-dot inv-dot--returns"></i> Returns <b id="pct-returns">—</b></span>
        </p>
      </div>

      <!-- Year-by-year growth -->
      <div class="calc-card" style="margin-top:0.875rem;padding:0;overflow:hidden">
        <div class="calc-card-head">
          <p class="calc-card-title" style="margin:0">Year-by-year growth</p>
          <button class="btn btn-secondary btn-sm" id="toggle-growth">Show table</button>
        </div>
        <div id="growth-wrap" class="hidden">
          <div class="table-wrap" style="border:none;border-radius:0;margin:0;max-height:26rem;overflow-y:auto">
            <table class="data-table" aria-label="Year-by-year investment growth">
              <thead>
                <tr>
                  <th>Year</th>
                  <th>Invested</th>
                  <th>Returns</th>
                  <th>Value</th>
                </tr>
              </thead>
              <tbody id="growth-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="inv-guide">
    <h2 id="inv-guide">How to Use the Investment Calculator</h2>
    <p>Pick whether you are investing monthly (SIP), as a one-time lumpsum, or both together. Enter your expected annual return and how long you plan to stay invested. The results update instantly as you type.</p>

    <h3>SIP vs Lumpsum: Which Is Better?</h3>
    <p>Neither is universally better — they solve different problems.</p>
    <table>
      <thead>
        <tr><th>Factor</th><th>SIP</th><th>Lumpsum</th></tr>
      </thead>
      <tbody>
        <tr><td>Best when</td><td>You earn monthly income</td><td>You already hold a large sum</td></tr>
        <tr><td>Market timing risk</td><td>Low — averaged over time</td><td>High — one entry point</td></tr>
        <tr><td>Compounding period</td><td>Shorter per instalment</td><td>Full duration on the whole sum</td></tr>
        <tr><td>Discipline</td><td>Automatic and habitual</td><td>Requires a one-off decision</td></tr>
        <tr><td>Typical use</td><td>Salaried savers building wealth</td><td>Bonus, inheritance, asset sale</td></tr>
      </tbody>
    </table>
    <p>If you have a lumpsum but fear investing at a market peak, many investors split the difference: park the money in a low-risk instrument and transfer a fixed amount monthly into equities. Use the <strong>Both combined</strong> mode to model a starting lumpsum plus ongoing monthly contributions.</p>

    <h3>The Formulas Behind the Numbers</h3>
    <p>Future value of a SIP (contributions at the start of each month):</p>
    <p><code>FV = P × [((1 + i)^n − 1) / i] × (1 + i)</code></p>
    <p>Future value of a lumpsum:</p>
    <p><code>FV = P × (1 + r)^t</code></p>
    <p>Where <code>P</code> is the amount invested, <code>i</code> is the monthly rate (annual ÷ 12 ÷ 100), <code>n</code> is the number of months, <code>r</code> is the annual rate, and <code>t</code> is the number of years.</p>

    <h3>Why Step-Up SIPs Matter</h3>
    <p>A step-up SIP raises your monthly contribution each year, typically in line with your salary. Because the increases happen early enough to still compound for years, the effect is far larger than most people expect — a 10% annual step-up on a 15-year plan often produces 50–70% more wealth than a flat SIP at the same starting amount.</p>

    <h3>Important Limitations</h3>
    <ul>
      <li>Returns are assumed to be constant. Real markets fluctuate year to year.</li>
      <li>Figures are <strong>nominal</strong> — they ignore inflation. Subtract your inflation estimate from the return rate to see real purchasing power.</li>
      <li>Expense ratios, exit loads, and capital gains tax are not deducted.</li>
      <li>This is an educational projection, not financial advice. Consult a qualified adviser before making investment decisions.</li>
    </ul>

    <h3>Related Calculators</h3>
    <ul>
      <li><a href="/finance/compound-interest-calculator/">Compound Interest Calculator</a> — model growth with flexible compounding frequencies.</li>
      <li><a href="/finance/mortgage-calculator/">Mortgage Payment Calculator</a> — see what a home loan costs alongside your investing plan.</li>
      <li><a href="/finance/loan-emi-calculator/">Loan EMI Calculator</a> — compare the cost of borrowing against investment returns.</li>
    </ul>
  </section>
</ToolLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }
  @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .stat-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1rem 1.125rem;
  }
  .stat-card--primary {
    border-color: var(--color-primary-muted);
    background: var(--color-primary-light);
  }
  .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .stat-card--primary .stat-label { color: var(--color-primary); }
  .stat-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    word-break: break-all;
  }

  /* Mode toggle */
  .inv-mode {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    background: var(--color-bg-secondary);
    padding: 0.3125rem;
    border-radius: var(--radius-lg);
    margin-bottom: 1.25rem;
  }
  .inv-mode-btn {
    flex: 1;
    min-width: 7rem;
    padding: 0.5rem 0.875rem;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: calc(var(--radius-lg) - 3px);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .inv-mode-btn.active {
    background: var(--color-bg-card);
    color: var(--color-primary);
    box-shadow: 0 1px 3px rgba(0,0,0,.1);
  }

  /* Fields */
  .inv-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 560px) { .inv-fields { grid-template-columns: repeat(2, 1fr); } }

  .inv-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }
  .inv-optional {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Invested vs returns bar */
  .inv-bar {
    display: flex;
    height: 2rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-secondary);
  }
  .inv-bar-invested { background: var(--color-primary); transition: width .35s ease; }
  .inv-bar-returns  { background: #059669; transition: width .35s ease; }

  .inv-bar-legend {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .inv-bar-legend b { color: var(--color-text); }
  .inv-dot {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    margin-right: 0.375rem;
  }
  .inv-dot--invested { background: var(--color-primary); }
  .inv-dot--returns  { background: #059669; }

  .calc-card-head {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-sm { padding: 0.375rem 0.875rem; font-size: var(--text-sm); }
</style>

<script>
  type Mode = 'sip' | 'lump' | 'both';
  let mode: Mode = 'sip';

  const $ = (id: string) => document.getElementById(id)!;
  const numOf = (id: string) => parseFloat(($(id) as HTMLInputElement).value);

  function fmt(n: number): string {
    return Math.round(n).toLocaleString('en-US');
  }

  function setMode(next: Mode) {
    mode = next;
    const map: Record<Mode, string> = { sip: 'mode-sip', lump: 'mode-lump', both: 'mode-both' };
    (['sip', 'lump', 'both'] as Mode[]).forEach((m) => {
      const btn = $(map[m]);
      const on = m === next;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-pressed', String(on));
    });

    $('field-sip').classList.toggle('hidden', next === 'lump');
    $('field-lump').classList.toggle('hidden', next === 'sip');
    // Step-up only applies when there are monthly contributions
    $('field-stepup').classList.toggle('hidden', next === 'lump');

    calculate();
  }

  function calculate() {
    const years = numOf('inv-years');
    const annualRate = numOf('inv-rate');
    if ([years, annualRate].some(isNaN) || years <= 0 || annualRate < 0) return;

    const monthly = mode === 'lump' ? 0 : (numOf('inv-monthly') || 0);
    const lumpsum = mode === 'sip' ? 0 : (numOf('inv-lumpsum') || 0);
    const stepUp = mode === 'lump' ? 0 : (numOf('inv-stepup') || 0) / 100;

    if (monthly < 0 || lumpsum < 0) return;
    if (monthly === 0 && lumpsum === 0) return;

    const i = annualRate / 1200;
    const totalMonths = Math.round(years * 12);

    let balance = lumpsum;
    let invested = lumpsum;
    let contribution = monthly;
    const rows: { year: number; invested: number; value: number }[] = [];

    for (let m = 1; m <= totalMonths; m++) {
      // Contribution at the start of the month, then one month of growth
      balance += contribution;
      invested += contribution;
      balance *= 1 + i;

      if (m % 12 === 0) {
        rows.push({ year: m / 12, invested, value: balance });
        contribution *= 1 + stepUp;
      }
    }

    const returns = balance - invested;

    $('val-invested').textContent = fmt(invested);
    $('val-returns').textContent = fmt(returns);
    $('val-total').textContent = fmt(balance);
    $('val-multiple').textContent = (balance / invested).toFixed(2) + '×';

    // Proportion bar
    const investedPct = (invested / balance) * 100;
    ($('bar-invested') as HTMLElement).style.width = investedPct + '%';
    ($('bar-returns') as HTMLElement).style.width = 100 - investedPct + '%';
    $('pct-invested').textContent = investedPct.toFixed(1) + '%';
    $('pct-returns').textContent = (100 - investedPct).toFixed(1) + '%';

    // Growth table
    const body = $('growth-body');
    body.innerHTML = '';
    for (const r of rows) {
      const tr = document.createElement('tr');
      tr.innerHTML =
        `<td>${r.year}</td><td>${fmt(r.invested)}</td>` +
        `<td>${fmt(r.value - r.invested)}</td><td>${fmt(r.value)}</td>`;
      body.appendChild(tr);
    }
  }

  // Listeners
  $('mode-sip').addEventListener('click', () => setMode('sip'));
  $('mode-lump').addEventListener('click', () => setMode('lump'));
  $('mode-both').addEventListener('click', () => setMode('both'));
  $('inv-calc').addEventListener('click', calculate);

  ['inv-monthly', 'inv-lumpsum', 'inv-rate', 'inv-years', 'inv-stepup'].forEach((id) =>
    $(id).addEventListener('input', calculate)
  );

  $('inv-reset').addEventListener('click', () => {
    const defaults: Record<string, string> = {
      'inv-monthly': '10000',
      'inv-lumpsum': '100000',
      'inv-rate': '12',
      'inv-years': '10',
      'inv-stepup': '0',
    };
    Object.entries(defaults).forEach(([id, v]) => (($(id) as HTMLInputElement).value = v));
    setMode('sip');
  });

  $('toggle-growth').addEventListener('click', () => {
    const hidden = $('growth-wrap').classList.toggle('hidden');
    $('toggle-growth').textContent = hidden ? 'Show table' : 'Hide table';
  });

  calculate();
</script>
