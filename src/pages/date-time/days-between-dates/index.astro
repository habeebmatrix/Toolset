---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'days-between-dates')!;

const faqs = [
  {
    q: 'How do I count days between two dates?',
    a: 'Subtract the earlier date from the later date. This calculator handles the computation automatically, including leap years.',
  },
  {
    q: 'Are weekends included in the count?',
    a: 'The total days count includes all calendar days. The calculator also shows working days separately, which excludes Saturdays and Sundays.',
  },
  {
    q: 'Does the calculator include or exclude the end date?',
    a: 'The calculator counts the difference inclusively of the start date up to but not including the end date — the standard mathematical date difference.',
  },
  {
    q: 'How many days are in a year?',
    a: 'A standard year has 365 days. A leap year (divisible by 4, with exceptions for century years) has 366 days. The calculator accounts for leap years automatically.',
  },
];
---

<ToolLayout tool={tool} faqs={faqs}>
  <div class="calc-cards" role="region" aria-label="Days between dates calculator">

    <div class="calc-card">
      <p class="calc-card-title">Calculate days between two dates</p>
      <div class="calc-sentence">
        <span>From</span>
        <input class="input-inline date-input" type="date" id="dbd-from" aria-label="Start date" />
        <span>to</span>
        <input class="input-inline date-input" type="date" id="dbd-to" aria-label="End date" />
      </div>
      <div class="calc-card-actions">
        <button class="btn btn-primary" id="calc-dbd">Calculate</button>
        <button class="btn btn-secondary" id="reset-dbd">Reset</button>
      </div>
      <div id="dbd-error" class="hidden" style="margin-top:1rem;padding:0.75rem 1rem;background:color-mix(in srgb,var(--color-error) 10%,var(--color-bg));border:1.5px solid var(--color-error);border-radius:var(--radius-lg);font-size:var(--text-sm);color:var(--color-error);font-weight:500">
        End date must be after start date.
      </div>
    </div>

    <!-- Results -->
    <div id="dbd-results" class="hidden" aria-live="polite" aria-atomic="true">
      <div class="stats-grid">
        <div class="stat-card stat-card--primary">
          <p class="stat-label">Total Days</p>
          <p class="stat-value" id="val-days">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Working Days</p>
          <p class="stat-value" id="val-working">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Weekend Days</p>
          <p class="stat-value" id="val-weekend">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Weeks</p>
          <p class="stat-value" id="val-weeks">—</p>
        </div>
      </div>

      <div class="calc-card" style="margin-top:0">
        <p class="calc-card-title">Breakdown</p>
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Years</span><strong id="val-years">—</strong>
          </div>
          <div class="breakdown-row">
            <span>Months</span><strong id="val-months">—</strong>
          </div>
          <div class="breakdown-row">
            <span>Days (remainder)</span><strong id="val-days-rem">—</strong>
          </div>
          <div class="breakdown-row">
            <span>Total hours</span><strong id="val-hours">—</strong>
          </div>
        </div>
      </div>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="dates-explainer">
    <h2 id="dates-explainer">How Date Differences Work</h2>
    <p>The number of days between two dates is calculated by converting each date to a timestamp and finding the difference. The result accounts for varying month lengths and leap years automatically.</p>
    <h3>Working Days</h3>
    <p>Working days (also called business days) are Monday through Friday, excluding weekends. This calculator counts all weekday occurrences between the two dates — it does not account for public holidays, which vary by country.</p>
  </section>
</ToolLayout>

<style>
  .date-input { width: 10rem; text-align: left; padding-inline: 0.5rem; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }
  @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .stat-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1rem 1.125rem;
  }
  .stat-card--primary {
    border-color: var(--color-primary-muted);
    background: var(--color-primary-light);
  }
  .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .stat-card--primary .stat-label { color: var(--color-primary); }
  .stat-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .breakdown-list { display: flex; flex-direction: column; }
  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .breakdown-row:last-child { border-bottom: none; }
  .breakdown-row strong { font-size: var(--text-base); color: var(--color-text); }
</style>

<script>
  function set(id: string, text: string) {
    document.getElementById(id)!.textContent = text;
  }

  function countWorkingDays(from: Date, to: Date): number {
    let count = 0;
    const cur = new Date(from);
    while (cur < to) {
      const day = cur.getDay();
      if (day !== 0 && day !== 6) count++;
      cur.setDate(cur.getDate() + 1);
    }
    return count;
  }

  function calcDbd() {
    const fromVal = (document.getElementById('dbd-from') as HTMLInputElement).value;
    const toVal = (document.getElementById('dbd-to') as HTMLInputElement).value;
    document.getElementById('dbd-error')!.classList.add('hidden');
    document.getElementById('dbd-results')!.classList.add('hidden');

    if (!fromVal || !toVal) return;

    const from = new Date(fromVal);
    const to = new Date(toVal);

    if (to <= from) {
      document.getElementById('dbd-error')!.classList.remove('hidden');
      return;
    }

    const msPerDay = 86400000;
    const totalDays = Math.round((to.getTime() - from.getTime()) / msPerDay);
    const working = countWorkingDays(from, to);

    // Years / months / days breakdown
    let years = to.getFullYear() - from.getFullYear();
    let months = to.getMonth() - from.getMonth();
    let days = to.getDate() - from.getDate();
    if (days < 0) { months--; days += new Date(to.getFullYear(), to.getMonth(), 0).getDate(); }
    if (months < 0) { years--; months += 12; }

    set('val-days', totalDays.toLocaleString());
    set('val-working', working.toLocaleString());
    set('val-weekend', (totalDays - working).toLocaleString());
    set('val-weeks', (totalDays / 7).toFixed(1));
    set('val-years', years.toString());
    set('val-months', months.toString());
    set('val-days-rem', days.toString());
    set('val-hours', (totalDays * 24).toLocaleString());

    document.getElementById('dbd-results')!.classList.remove('hidden');
  }

  // Set default dates: today and 30 days from now
  const today = new Date();
  const later = new Date(today);
  later.setDate(later.getDate() + 30);
  (document.getElementById('dbd-from') as HTMLInputElement).value = today.toISOString().slice(0, 10);
  (document.getElementById('dbd-to') as HTMLInputElement).value = later.toISOString().slice(0, 10);
  calcDbd();

  document.getElementById('calc-dbd')!.addEventListener('click', calcDbd);

  document.getElementById('reset-dbd')!.addEventListener('click', () => {
    (document.getElementById('dbd-from') as HTMLInputElement).value = '';
    (document.getElementById('dbd-to') as HTMLInputElement).value = '';
    document.getElementById('dbd-results')!.classList.add('hidden');
    document.getElementById('dbd-error')!.classList.add('hidden');
  });

  ['dbd-from', 'dbd-to'].forEach((id) =>
    document.getElementById(id)!.addEventListener('change', calcDbd)
  );
</script>
