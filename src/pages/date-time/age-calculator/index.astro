---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'age-calculator')!;

const faqs = [
  {
    q: 'How is age calculated?',
    a: 'Age is the difference between your date of birth and today\'s date, measured in complete years, then remaining months, then remaining days.',
  },
  {
    q: 'What is my age in days?',
    a: 'Multiply your age in years by 365.25 (to account for leap years) and add the days in the current partial year. This calculator computes the exact count.',
  },
  {
    q: 'When is my next birthday?',
    a: 'Your next birthday is the next occurrence of your birth month and day. If it has already occurred this year, the next one is next year.',
  },
  {
    q: 'What day of the week was I born?',
    a: 'The calculator determines the day of the week of your birth date using the date\'s timestamp.',
  },
];
---

<ToolLayout tool={tool} faqs={faqs}>
  <div class="calc-cards" role="region" aria-label="Age calculator">

    <div class="calc-card">
      <p class="calc-card-title">Calculate your age</p>
      <div class="calc-sentence">
        <span>I was born on</span>
        <input class="input-inline date-input" type="date" id="age-dob" aria-label="Date of birth" />
      </div>
      <div class="calc-card-actions">
        <button class="btn btn-primary" id="calc-age">Calculate</button>
        <button class="btn btn-secondary" id="reset-age">Reset</button>
      </div>
    </div>

    <!-- Results -->
    <div id="age-results" class="hidden" aria-live="polite" aria-atomic="true">
      <!-- Primary age -->
      <div class="calc-card" style="text-align:center">
        <p class="calc-card-title" style="text-align:left">Your Age</p>
        <p id="age-primary" style="font-size:clamp(2rem,7vw,3.5rem);font-weight:800;letter-spacing:-0.03em;color:var(--color-primary);line-height:1;margin-bottom:0.25rem"></p>
        <p id="age-sub" style="font-size:var(--text-base);color:var(--color-text-secondary)"></p>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <p class="stat-label">Total Days</p>
          <p class="stat-value" id="val-age-days">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Total Hours</p>
          <p class="stat-value" id="val-age-hours">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Total Weeks</p>
          <p class="stat-value" id="val-age-weeks">—</p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Total Months</p>
          <p class="stat-value" id="val-age-months-total">—</p>
        </div>
      </div>

      <div class="calc-card" style="margin-top:0">
        <p class="calc-card-title">More details</p>
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Day you were born</span><strong id="val-birth-day">—</strong>
          </div>
          <div class="breakdown-row">
            <span>Next birthday</span><strong id="val-next-bday">—</strong>
          </div>
          <div class="breakdown-row">
            <span>Days until next birthday</span><strong id="val-days-to-bday">—</strong>
          </div>
        </div>
      </div>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="age-explainer">
    <h2 id="age-explainer">How Age is Calculated</h2>
    <p>Your age in years is the number of complete years that have elapsed since your date of birth. After the years, the remaining months and days are counted. This is how official documents (passports, legal forms) calculate age.</p>
    <h3>Leap Year Birthdays</h3>
    <p>If you were born on 29 February, your birthday on non-leap years is typically counted as 28 February or 1 March depending on local convention. This calculator uses the date as entered.</p>
  </section>
</ToolLayout>

<style>
  .date-input { width: 10rem; text-align: left; padding-inline: 0.5rem; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }
  @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .stat-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1rem 1.125rem;
  }
  .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .stat-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    word-break: break-all;
  }

  .breakdown-list { display: flex; flex-direction: column; }
  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    gap: 1rem;
  }
  .breakdown-row:last-child { border-bottom: none; }
  .breakdown-row strong { font-size: var(--text-base); color: var(--color-text); text-align: right; }
</style>

<script>
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  function set(id: string, text: string) {
    document.getElementById(id)!.textContent = text;
  }

  function calcAge() {
    const dobVal = (document.getElementById('age-dob') as HTMLInputElement).value;
    document.getElementById('age-results')!.classList.add('hidden');
    if (!dobVal) return;

    const dob = new Date(dobVal);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    if (dob >= today) return;

    // Exact age
    let years = today.getFullYear() - dob.getFullYear();
    let months = today.getMonth() - dob.getMonth();
    let days = today.getDate() - dob.getDate();
    if (days < 0) { months--; days += new Date(today.getFullYear(), today.getMonth(), 0).getDate(); }
    if (months < 0) { years--; months += 12; }

    const totalDays = Math.floor((today.getTime() - dob.getTime()) / 86400000);

    // Next birthday
    const nextBday = new Date(today.getFullYear(), dob.getMonth(), dob.getDate());
    if (nextBday <= today) nextBday.setFullYear(nextBday.getFullYear() + 1);
    const daysToNextBday = Math.round((nextBday.getTime() - today.getTime()) / 86400000);

    // Primary display
    document.getElementById('age-primary')!.textContent = `${years} years`;
    set('age-sub', `${months} month${months !== 1 ? 's' : ''} and ${days} day${days !== 1 ? 's' : ''} old`);

    set('val-age-days', totalDays.toLocaleString());
    set('val-age-hours', (totalDays * 24).toLocaleString());
    set('val-age-weeks', Math.floor(totalDays / 7).toLocaleString());
    set('val-age-months-total', (years * 12 + months).toLocaleString());
    set('val-birth-day', DAYS[dob.getDay()]);
    set('val-next-bday', `${MONTHS[nextBday.getMonth()]} ${nextBday.getDate()}, ${nextBday.getFullYear()}`);
    set('val-days-to-bday', daysToNextBday === 0 ? '🎂 Today!' : `${daysToNextBday} days`);

    document.getElementById('age-results')!.classList.remove('hidden');
  }

  document.getElementById('calc-age')!.addEventListener('click', calcAge);

  document.getElementById('reset-age')!.addEventListener('click', () => {
    (document.getElementById('age-dob') as HTMLInputElement).value = '';
    document.getElementById('age-results')!.classList.add('hidden');
  });

  document.getElementById('age-dob')!.addEventListener('change', calcAge);
</script>
