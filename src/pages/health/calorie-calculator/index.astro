---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { tools } from '../../../data/tools';

const tool = tools.find((t) => t.slug === 'calorie-calculator')!;

const faqs = [
  {
    q: 'What is BMR?',
    a: 'Basal Metabolic Rate (BMR) is the number of calories your body needs to perform basic life-sustaining functions at rest — breathing, circulation, cell production, and temperature regulation.',
  },
  {
    q: 'What is TDEE?',
    a: 'Total Daily Energy Expenditure (TDEE) is your BMR multiplied by an activity factor. It represents the total calories you burn per day, including physical activity.',
  },
  {
    q: 'Which equation does this calculator use?',
    a: 'This calculator uses the Mifflin-St Jeor equation, which is considered the most accurate for most people. Men: BMR = (10 × kg) + (6.25 × cm) − (5 × age) + 5. Women: BMR = (10 × kg) + (6.25 × cm) − (5 × age) − 161.',
  },
  {
    q: 'How many calories should I eat to lose weight?',
    a: 'A deficit of 500 kcal/day typically leads to roughly 0.5 kg (1 lb) of weight loss per week. A deficit of 1000 kcal/day is considered aggressive. It is generally not recommended to eat below 1200 kcal/day (women) or 1500 kcal/day (men).',
  },
  {
    q: 'Are calorie calculators accurate?',
    a: 'These formulas provide estimates. Individual metabolism varies based on genetics, hormones, and body composition. Use the result as a starting point and adjust based on real-world results over 2–4 weeks.',
  },
];
---

<ToolLayout tool={tool} faqs={faqs}>
  <div class="calc-cards" role="region" aria-label="Calorie calculator">

    <div class="calc-card">
      <p class="calc-card-title">Your details</p>

      <div class="calorie-form">
        <div class="calorie-row">
          <label class="calorie-label" for="cal-sex">Sex</label>
          <select class="select" id="cal-sex" aria-label="Biological sex">
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </div>
        <div class="calorie-row">
          <label class="calorie-label" for="cal-age">Age (years)</label>
          <input class="input" type="number" id="cal-age" placeholder="e.g. 30" min="10" max="100" step="1" />
        </div>
        <div class="calorie-row">
          <label class="calorie-label" for="cal-height">Height (cm)</label>
          <input class="input" type="number" id="cal-height" placeholder="e.g. 175" min="100" max="250" step="any" />
        </div>
        <div class="calorie-row">
          <label class="calorie-label" for="cal-weight">Weight (kg)</label>
          <input class="input" type="number" id="cal-weight" placeholder="e.g. 70" min="20" max="300" step="any" />
        </div>
        <div class="calorie-row calorie-row--full">
          <label class="calorie-label" for="cal-activity">Activity level</label>
          <select class="select" id="cal-activity">
            <option value="1.2">Sedentary — little or no exercise</option>
            <option value="1.375">Lightly active — exercise 1–3 days/week</option>
            <option value="1.55" selected>Moderately active — exercise 3–5 days/week</option>
            <option value="1.725">Very active — hard exercise 6–7 days/week</option>
            <option value="1.9">Super active — physical job + hard exercise</option>
          </select>
        </div>
      </div>

      <div class="calc-card-actions" style="margin-top:1.25rem">
        <button class="btn btn-primary" id="calc-calories">Calculate</button>
        <button class="btn btn-secondary" id="reset-calories">Reset</button>
      </div>
    </div>

    <!-- Results -->
    <div id="cal-results" class="hidden" aria-live="polite" aria-atomic="true">
      <!-- BMR + TDEE -->
      <div class="stats-grid" style="margin-bottom:0.875rem">
        <div class="stat-card">
          <p class="stat-label">BMR</p>
          <p class="stat-value" id="val-bmr">—</p>
          <p style="font-size:var(--text-xs);color:var(--color-text-muted);margin-top:0.125rem">kcal/day at rest</p>
        </div>
        <div class="stat-card stat-card--primary">
          <p class="stat-label">TDEE (Maintenance)</p>
          <p class="stat-value" id="val-tdee">—</p>
          <p style="font-size:var(--text-xs);color:var(--color-primary);margin-top:0.125rem">kcal/day with activity</p>
        </div>
      </div>

      <!-- Goal targets -->
      <div class="calc-card" style="margin-top:0">
        <p class="calc-card-title">Daily calorie targets by goal</p>
        <div class="goal-list">
          <div class="goal-row">
            <div>
              <p class="goal-label">Extreme weight loss</p>
              <p class="goal-sub">−1000 kcal/day · ~1 kg/week</p>
            </div>
            <p class="goal-value" id="val-extreme-loss">—</p>
          </div>
          <div class="goal-row">
            <div>
              <p class="goal-label">Moderate weight loss</p>
              <p class="goal-sub">−500 kcal/day · ~0.5 kg/week</p>
            </div>
            <p class="goal-value" id="val-mod-loss">—</p>
          </div>
          <div class="goal-row goal-row--highlight">
            <div>
              <p class="goal-label">Maintain weight</p>
              <p class="goal-sub">Your TDEE</p>
            </div>
            <p class="goal-value" id="val-maintain">—</p>
          </div>
          <div class="goal-row">
            <div>
              <p class="goal-label">Moderate weight gain</p>
              <p class="goal-sub">+500 kcal/day · ~0.5 kg/week</p>
            </div>
            <p class="goal-value" id="val-mod-gain">—</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <section class="mt-8 prose" aria-labelledby="calorie-explainer">
    <h2 id="calorie-explainer">How Your Calorie Needs are Calculated</h2>
    <p>This tool uses the <strong>Mifflin-St Jeor equation</strong> (1990), the most validated formula for estimating BMR in modern research.</p>
    <p>Men: <code>BMR = (10 × kg) + (6.25 × cm) − (5 × age) + 5</code></p>
    <p>Women: <code>BMR = (10 × kg) + (6.25 × cm) − (5 × age) − 161</code></p>
    <p>Your BMR is then multiplied by an activity factor (1.2 to 1.9) to get your TDEE — the total calories you burn each day.</p>
    <h3>Using Your Results</h3>
    <p>Track your actual intake and weight for 2–4 weeks. If your weight is not changing as expected, adjust your target by 100–200 kcal and reassess. The formula is an estimate; real-world data is always more reliable over time.</p>
  </section>
</ToolLayout>

<style>
  .calorie-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 0;
  }
  @media (min-width: 480px) {
    .calorie-form { grid-template-columns: 1fr 1fr; }
  }

  .calorie-row { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .calorie-row--full { grid-column: 1 / -1; }
  .calorie-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }
  .stat-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1rem 1.125rem;
  }
  .stat-card--primary {
    border-color: var(--color-primary-muted);
    background: var(--color-primary-light);
  }
  .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .stat-card--primary .stat-label { color: var(--color-primary); }
  .stat-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .goal-list { display: flex; flex-direction: column; gap: 0; }
  .goal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .goal-row:last-child { border-bottom: none; }
  .goal-row--highlight { background: var(--color-primary-light); margin-inline: -1.5rem; padding-inline: 1.5rem; }
  .goal-label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  .goal-sub { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.125rem; }
  .goal-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<script>
  function num(id: string): number {
    return parseFloat((document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value);
  }

  function set(id: string, text: string) {
    document.getElementById(id)!.textContent = text;
  }

  function kcal(n: number): string {
    return Math.max(0, Math.round(n)).toLocaleString('en-US') + ' kcal';
  }

  function calcCalories() {
    const sex = (document.getElementById('cal-sex') as HTMLSelectElement).value;
    const age = num('cal-age');
    const height = num('cal-height');
    const weight = num('cal-weight');
    const activity = parseFloat((document.getElementById('cal-activity') as HTMLSelectElement).value);

    if ([age, height, weight].some(isNaN) || age <= 0 || height <= 0 || weight <= 0) return;

    const bmr = sex === 'male'
      ? 10 * weight + 6.25 * height - 5 * age + 5
      : 10 * weight + 6.25 * height - 5 * age - 161;

    const tdee = bmr * activity;

    set('val-bmr', kcal(bmr));
    set('val-tdee', kcal(tdee));
    set('val-extreme-loss', kcal(tdee - 1000));
    set('val-mod-loss', kcal(tdee - 500));
    set('val-maintain', kcal(tdee));
    set('val-mod-gain', kcal(tdee + 500));

    document.getElementById('cal-results')!.classList.remove('hidden');
  }

  document.getElementById('calc-calories')!.addEventListener('click', calcCalories);

  document.getElementById('reset-calories')!.addEventListener('click', () => {
    ['cal-age', 'cal-height', 'cal-weight'].forEach(
      (id) => ((document.getElementById(id) as HTMLInputElement).value = '')
    );
    (document.getElementById('cal-sex') as HTMLSelectElement).value = 'male';
    (document.getElementById('cal-activity') as HTMLSelectElement).value = '1.55';
    document.getElementById('cal-results')!.classList.add('hidden');
  });

  ['cal-sex', 'cal-age', 'cal-height', 'cal-weight', 'cal-activity'].forEach((id) =>
    document.getElementById(id)!.addEventListener('input', calcCalories)
  );
</script>
