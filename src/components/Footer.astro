---
import { categories } from '../data/tools';

const year = new Date().getFullYear();
const col1 = categories.slice(0, 4);
const col2 = categories.slice(4);
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="Utiltrix Toolkit home">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:1.75rem;height:1.75rem">
            <rect width="32" height="32" rx="8" fill="#4F46E5"/>
            <rect x="7" y="9.5" width="18" height="3" rx="1.5" fill="white"/>
            <rect x="7" y="14.5" width="12" height="3" rx="1.5" fill="white"/>
            <rect x="7" y="19.5" width="15" height="3" rx="1.5" fill="white"/>
          </svg>
          Utiltrix Toolkit
        </a>
        <p>
          Free online calculators and tools for everyday tasks. No signup, no ads, no tracking.
          Fast, accurate, and mobile-friendly.
        </p>
      </div>

      <div class="footer-col">
        <h3>Categories</h3>
        <ul>
          {col1.map((cat) => (
            <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>&nbsp;</h3>
        <ul>
          {col2.map((cat) => (
            <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>Site</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Utiltrix Toolkit. All rights reserved.</p>
      <p>Built for speed. No tracking. No cookies.</p>
    </div>
  </div>
</footer>
