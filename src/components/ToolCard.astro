---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const href = `/${tool.category}/${tool.slug}/`;
---

{tool.isReady ? (
  <a href={href} class="tool-card" aria-label={`${tool.name} — ${tool.shortDescription}`}>
    <div class="tool-card-header">
      <h3>{tool.name}</h3>
      {tool.isNew && <span class="badge badge-new">New</span>}
    </div>
    <p>{tool.shortDescription}</p>
    <div class="tool-card-footer">
      <span>Open tool</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </div>
  </a>
) : (
  <div class="tool-card coming-soon-card" aria-label={`${tool.name} — coming soon`}>
    <div class="tool-card-header">
      <h3>{tool.name}</h3>
      <span class="badge badge-soon">Soon</span>
    </div>
    <p>{tool.shortDescription}</p>
    <div class="tool-card-footer">
      <span style="color:var(--color-text-muted)">Coming soon</span>
    </div>
  </div>
)}
